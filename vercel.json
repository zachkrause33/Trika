{
  "rewrites": [
    { "source": "/numbers", "destination": "/numbers.html" },
    { "source": "/blitz", "destination": "/blitz.html" },
    { "source": "/precision", "destination": "/precision.html" },
    { "source": "/survival", "destination": "/survival.html" },
    { "source": "/privacy", "destination": "/privacy.html" }
  ],
  "headers": [
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    }
  ]
}
